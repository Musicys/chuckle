# 应用的基础 URL，默认为 "/"
# 如果使用子目录，必须以 "/" 结尾，例如 "/admin/" 而不是 "/admin"
VITE_BASE_URL=/

# 应用标题
VITE_APP_TITLE=QXchuckle Admin

# 应用描述
VITE_APP_DESC=QXchuckle Admin is a blog management system based on SoybeanAdmin

# 图标名称的前缀
VITE_ICON_PREFIX=icon

# 本地 SVG 图标组件的前缀，必须包含 VITE_ICON_PREFIX
# 格式为 {VITE_ICON_PREFIX}-{本地图标名称}
VITE_ICON_LOCAL_PREFIX=icon-local

# 鉴权路由模式：static（静态）｜ dynamic（动态）
VITE_AUTH_ROUTE_MODE=static

# 静态鉴权路由的首页
VITE_ROUTE_HOME=home

# 默认菜单图标
VITE_MENU_ICON=mdi:menu

# 开发模式下是否启用 HTTP 代理
VITE_HTTP_PROXY=Y

# Vue Router 路由模式：hash | history | memory
VITE_ROUTER_HISTORY_MODE=history

# 后端服务的成功状态码，收到此代码表示请求成功
VITE_SERVICE_SUCCESS_CODE=0000

# 后端服务的登出状态码，收到这些代码时，用户将被登出并重定向到登录页
VITE_SERVICE_LOGOUT_CODES=8888,8889

# 后端服务的弹窗登出状态码，收到这些代码时，将通过弹窗提示用户登出
VITE_SERVICE_MODAL_LOGOUT_CODES=7777,7778

# 后端服务的 Token 过期状态码，收到这些代码时，将刷新 Token 并重发请求
VITE_SERVICE_EXPIRED_TOKEN_CODES=9999,9998,3333

# 当路由模式为静态时，定义的超级管理员角色
VITE_STATIC_SUPER_ROLE=R_SUPER

# 是否生成 sourcemap（源码映射）
VITE_SOURCE_MAP=N

# 用于区分不同域名下的本地存储（LocalStorage/SessionStorage）
VITE_STORAGE_PREFIX=SOY_

# 用于控制程序是否自动检测更新
VITE_AUTOMATICALLY_DETECT_UPDATE=Y

# 是否在终端显示代理 URL 的日志
VITE_PROXY_LOG=Y

# 用于控制是否启动编辑器
# 顺便一提，该插件仅在开发模式下可用，构建模式下不可用
VITE_DEVTOOLS_LAUNCH_EDITOR=code
